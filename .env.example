# Only needed if you run scripts/adaptionlabs_quickstart.py
ADAPTION_API_KEY=

# Only needed if you run scripts/satellite_gee.py -- Earth Engine now requires a Google Cloud
# project on every Initialize() call. Create/select one at https://console.cloud.google.com
# (Earth Engine API enabled) or register free at https://code.earthengine.google.com/register
EE_PROJECT=

